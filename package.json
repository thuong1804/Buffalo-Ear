{
    "name": "buffalo-ear",
    "version": "2.0.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "vite --host 127.0.0.1 --port 5174 --strictPort",
        "build": "vite build",
        "start": "node --env-file-if-exists=.env scripts/start-server.mjs",
        "preview": "npm run start",
        "typecheck": "tsc --noEmit",
        "test": "tsx --test tests/*.test.ts tests/*.test.mjs",
        "test:browser": "node tests/browser.cjs",
        "test:integration": "node --env-file-if-exists=.env tests/integration.cjs",
        "db:up": "docker compose up -d --wait",
        "db:generate": "drizzle-kit generate",
        "db:migrate": "drizzle-kit migrate",
        "db:studio": "drizzle-kit studio",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "test:styles": "node tests/styles.cjs",
        "test:ipa": "node tests/ipa-browser.cjs",
        "test:voice": "node tests/voice-browser.cjs",
        "test:i18n": "node tests/i18n-browser.cjs",
        "test:dialogues": "node tests/dialogues-browser.cjs",
        "test:dialogue-content": "node --test tests/dialogue-content.test.mjs",
        "test:dialogue-filters": "node tests/dialogue-filters-browser.cjs",
        "test:tenses": "node tests/tenses-browser.cjs",
        "test:mobile-navigation": "node tests/mobile-navigation.cjs"
    },
    "dependencies": {
        "@better-auth/drizzle-adapter": "1.7.13",
        "@tanstack/react-query": "^5.104.5",
        "@tanstack/react-router": "1.170.46",
        "@tanstack/react-start": "1.169.4",
        "better-auth": "1.7.13",
        "dotenv": "^17.3.1",
        "drizzle-orm": "^0.45.2",
        "i18next": "^26.5.11",
        "lucide-react": "^0.468.0",
        "postgres": "^3.4.8",
        "react": "^19.0.0",
        "react-dom": "^19.0.0",
        "react-i18next": "^17.1.9",
        "zod": "^4.3.6"
    },
    "devDependencies": {
        "@tailwindcss/vite": "^4.3.3",
        "@types/node": "^24.0.0",
        "@types/react": "^19.0.0",
        "@types/react-dom": "^19.0.0",
        "@vitejs/plugin-react": "^6.1.2",
        "drizzle-kit": "^0.31.11",
        "nitro": "3.0.260903-beta",
        "playwright": "^1.64.1",
        "prettier": "^3.9.10",
        "prettier-plugin-tailwindcss": "^0.8.1",
        "tailwindcss": "^4.3.3",
        "tsx": "^4.21.0",
        "typescript": "^6.0.0",
        "vite": "^8.0.0"
    },
    "engines": {
        "node": ">=22.12.0"
    },
    "overrides": {
        "@esbuild-kit/core-utils": {
            "esbuild": "^0.25.12"
        }
    }
}
